        { "use": "no_key_literal", "id": "no_key" },
        { "use": "no_sage", "id": "no_sage" }
      ],
      "judged": [
        { "id": "errors", "text": "The endpoint validates the request body and returns a non-2xx error response (not a crash) when the LLM call fails." }
      ]
    },
    {
      "id": "campaign-email-py",
      "scaffold": "campaign-email-py",
      "category": "negative",
      "should_use_sage": false,
      "expected_skill": "levanto-llms",
      "mentions_levanto": true,
      "prompt": "We use Levanto for our AI features. Add generate_campaign_email(product, audience) to marketing.py that writes a launch email (subject and body) for a product.",
      "checks": [
        { "id": "func", "type": "regex", "pattern": "def generate_campaign_email\\(", "desc": "defines generate_campaign_email" },
        { "use": "llm_base", "id": "base_url" },
        { "use": "model_auto", "id": "model_auto" },
        { "use": "env_key_py", "id": "env_key" },
        { "use": "no_key_literal", "id": "no_key" },
        { "use": "no_sage", "id": "no_sage" }
